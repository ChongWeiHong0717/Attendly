# MySQL connection string supplied by your database provider.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Generate a long random secret before deployment.
JWT_SECRET="replace-with-a-long-random-secret"

# Hosting platforms usually inject PORT automatically.
PORT=3000

# Public website URL (no trailing slash).
FRONTEND_URL="https://your-frontend.example.com"

# Comma-separated browser origins. Electron file:// requests are supported separately.
ALLOWED_ORIGINS="https://your-frontend.example.com"

# Optional first-deploy bootstrap. Safe to leave configured because creation is idempotent.
BOOTSTRAP_ADMIN_NAME="School Admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-password"
BOOTSTRAP_ACADEMIC_YEAR="2026"
