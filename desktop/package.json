{
  "name": "attendance-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Attendly desktop administration and NFC attendance client",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron . --dist",
    "rebuild-hid": "electron-rebuild -f -w node-hid",
    "postinstall": "electron-rebuild -f -w node-hid"
  },
  "dependencies": {
    "node-hid": "^3.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^37.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
